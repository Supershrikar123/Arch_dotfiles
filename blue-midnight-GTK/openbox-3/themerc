# @TODO: finish replacing the colors here


# Menu
menu.border.color: #61afef

menu.title.bg: Solid Flat
menu.title.bg.color: #22333b
menu.title.bg.shadow: 0
menu.title.text.color: #61afef
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #22333b
menu.items.text.color: #61afef
menu.items.disabled.text.color: #5190c2

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #3f4e64
menu.items.active.text.color: #61afef

menu.separator.color: #5190c2
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #22333b

# Active window
window.active.border.color: #40bfff


window.active.title.bg: flat solid
window.active.title.bg.color: #22333b
window.active.title.separator.color: #22333b
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #61afef

window.active.handle.bg: flat solid
window.active.handle.bg.color: #22333b

window.active.grip.bg: flat solid
window.active.grip.bg.color: #22333b

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #22333b
window.active.button.unpressed.image.color: #61afef

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #3f4e64
window.active.button.pressed.image.color: #fab387

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #22333b
window.active.button.disabled.image.color: #5190c2

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #22333b
window.active.button.hover.image.color: #3f4e64

#window.active.button.toggled.bg: #3f4e64
#window.active.button.toggled.image.color: #fab387

# Inactive window
window.inactive.border.color: #3f4e64

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #22333b
window.inactive.title.separator.color: #22333b
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #5190c2

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #22333b

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #22333b

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #22333b
window.inactive.button.unpressed.image.color: #5190c2

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #3f4e64
window.inactive.button.pressed.image.color: #fab387

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #5190c2
window.inactive.button.disabled.image.color: #22333b

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #22333b
window.inactive.button.hover.image.color: #3f4e64


# OSD
osd.border.width: 1
osd.border.color: #3f4e64

osd.bg: flat solid
osd.bg.color: #22333b
osd.label.bg: flat solid
osd.label.bg.color: #22333b
osd.label.text.color: #61afef

# OSD
osd.bg: Solid Flat
osd.bg.color: #22333b
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #3f4e64
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #22333b

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #22333b
#osd.button.unpressed.*.border.color: #40bfff

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #3f4e64
#osd.button.pressed.*.border.color: #fab387

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #61afef
#osd.button.focused.*.border.color: #22333b

osd.button.focused.box.color: #3f4e64


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 0
padding.width: 8
padding.height: 0
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
